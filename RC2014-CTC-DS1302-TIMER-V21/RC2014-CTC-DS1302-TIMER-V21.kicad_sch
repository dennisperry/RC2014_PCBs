	(text "EXAMPLE IF 0x80 IS BASE\nSELECTED BY J2,J4,J3\nY0 = PINS 1-2 = 0x80\nY1 = PINS 3-4 = 0x84\nY2 = PINS 5-6 = 0x88\nY3 = PINS 7-8 = 0x8C\nY4 = PINS 9-10 = 0x90\nY5 = PINS 11-12 = 0x94\nY6 = PINS 13-14 = 0x98\nY7 = PINS 15-16 = 0x9C"
		(exclude_from_sim no)
		(at 242.57 56.388 0)
